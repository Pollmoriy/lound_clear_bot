BOT_TOKEN=your_token_from_botfather
ADMIN_IDS=123456789

# Локально можно оставить SQLite:
# DATABASE_URL=sqlite+aiosqlite:///loud_clear.db

# Для продакшена — Supabase, Session pooler (важно: НЕ Direct connection,
# у него только IPv6, а PythonAnywhere IPv4-only):
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- нужно только для деплоя на PythonAnywhere (webhook-режим) ---
# Придумай длинную случайную строку, например через:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=
# Твой username на PythonAnywhere (из адреса username.pythonanywhere.com)
PA_USERNAME=
# Только на самом PythonAnywhere — для локального запуска оставь пустым
PA_PROXY_URL=

PORT=10000
